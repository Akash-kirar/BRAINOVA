# Runtime
NODE_ENV="development"

# Supabase auth and data
# Replace with your own project values.
# Do not commit real secrets or API keys.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
# Legacy projects can use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.

# Gemini AI coach
# Keep this server-side only. Do not create VITE_GEMINI_API_KEY.
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# Razorpay payments
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
VITE_RAZORPAY_KEY_ID="your_razorpay_key_id"
