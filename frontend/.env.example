# Runtime
NODE_ENV="development"

# Supabase auth and data
# Set these values in your local environment or a secrets manager.
# Get the publishable key from Supabase Dashboard > Connect > Frameworks > React.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
# Legacy projects can use VITE_SUPABASE_ANON_KEY instead of VITE_SUPABASE_PUBLISHABLE_KEY.

# Gemini AI coach
# Keep this server-side only. Do not expose in frontend code.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Razorpay payments
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
VITE_RAZORPAY_KEY_ID="your_razorpay_key_id_here"
