# Copy this file to .env.local (or the environment-specific file used by your deployment).
# Never commit files containing real credentials. This file intentionally contains placeholders only.

# Runtime
NODE_ENV="development"

# Supabase
# The URL and publishable/anon key are safe for browser use, but protect your database with RLS.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Legacy Supabase projects may use this name instead:
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Gemini AI coach — server-side only.
# Never rename this to VITE_GEMINI_API_KEY: VITE_* variables are exposed to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3-flash-preview"

# Razorpay
# The key ID may be exposed to the checkout client; the secret must remain server-side.
RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"

# Security checklist:
# - Use separate credentials for development, staging, and production.
# - If any real value was ever committed, revoke/rotate it immediately; deleting the file is not enough.
# - Keep .env*, except this example file, ignored by Git.
